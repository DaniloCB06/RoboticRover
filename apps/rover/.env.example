# IP ou hostname do notebook que hospeda o Mosquitto (não o IP da Raspberry).
# No notebook para teste local sem a placa, use 127.0.0.1.
MQTT_HOST=192.168.1.100
MQTT_PORT=1883
MQTT_CLIENT_ID=roboticrover-pi3
# MQTT_USER=rover
# MQTT_PASSWORD=coloque_sua_senha_somente_no_env_local
STATUS_INTERVAL_SEC=5
# Não publicar telemetria inventada por padrão:
ENABLE_MOCK_TELEMETRY=false
LOG_LEVEL=INFO
