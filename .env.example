# Host visto pelo simulador executado no notebook.
MQTT_HOST=127.0.0.1
MQTT_PORT=1883
MQTT_CLIENT_ID=rover-sim-01
MQTT_KEEPALIVE=5
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CA_FILE=
# Dentro da rede Docker: o host/porta do serviço, não a porta publicada acima.
STATION_MQTT_HOST=mosquitto
STATION_MQTT_PORT=1883
STATION_CLIENT_ID=station-nodered-01
STATION_SOURCE=station-nodered
MQTT_BIND_ADDRESS=127.0.0.1
NODE_RED_PORT=1880
TELEMETRY_INTERVAL=1
HEARTBEAT_TIMEOUT=4
LOG_LEVEL=INFO

# Tração da Pi: opt-in explícito, desligada por padrão. Não controla o braço.
MOTOR_BACKEND=simulation
# Preencher com a porta real do Mega antes de escolher serial.
MOTOR_SERIAL_PORT=
MOTOR_PWM=80
MOTOR_LEASE_MS=300
MOTOR_ACK_TIMEOUT_SEC=0.15
MOTOR_RESET_DELAY_SEC=2
MOTOR_INVERT_LEFT=0
MOTOR_INVERT_RIGHT=0

# Só para os processos de competição. Use a senha entregue à equipe, fora do Git.
COMPETITION_HOST=
COMPETITION_TEAM=rover04
COMPETITION_PASSWORD=
COMPETITION_MQTT_PORT=1883
# Caminho relativo ao diretório de onde se inicia o agente e o detector.
COMPETITION_TELEMETRY_DIR=.runtime/competition
